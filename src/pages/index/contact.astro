
<section id="contact"
    class="grid gap-8 border-t border-[#C5A46D] p-8 md:grid-cols-2 md:p-16">

    <div>
        <p class="inline-block border border-[#C5A46D] px-4 py-2 font-black text-[#C5A46D]">
            LET'S WORK TOGETHER
        </p>

        <h2 class="mt-6 text-5xl font-black uppercase text-white md:text-7xl">
            Let's<br>
            Design<span class="text-[#C5A46D]">.</span>
        </h2>

        <p class="mt-5 leading-7 text-gray-400">
            Need AutoCAD drafting or a clear, user-friendly interface?
            Tell us about your project and we can discuss the right design approach.
        </p>

        <div class="mt-8 space-y-3 text-sm text-gray-300">
            <p>AUTOCAD DRAFTING</p>
            <p>UI/UX DESIGN</p>
            <p>DIGITAL PROTOTYPING</p>
        </div>
    </div>

    <form class="light-card card p-6" onsubmit="sendMessage(event)">

        <h3 class="mb-6 text-2xl font-black uppercase">
            Send an Inquiry.
        </h3>

        <label for="name" class="font-black">
            YOUR NAME
        </label>

        <input id="name"
            type="text"
            required
            placeholder="Enter your name"
            class="mt-3 w-full border-2 border-[#C5A46D] bg-transparent p-4">

        <label for="email" class="mt-5 block font-black">
            YOUR EMAIL
        </label>

        <input id="email"
            type="email"
            required
            placeholder="yourname@email.com"
            class="mt-3 w-full border-2 border-[#C5A46D] bg-transparent p-4">

        <label for="service" class="mt-5 block font-black">
            TYPE OF INQUIRY
        </label>

        <select id="service"
            required
            class="mt-3 w-full border-2 border-[#C5A46D] bg-transparent p-4">
            <option value="">Select an inquiry</option>
            <option value="AutoCAD Drafting">AutoCAD Drafting</option>
            <option value="UI/UX Design">UI/UX Design</option>
            <option value="Digital Prototyping">Digital Prototyping</option>
        </select>

        <label for="message" class="mt-5 block font-black">
            YOUR MESSAGE
        </label>

        <textarea id="message"
            required
            rows="4"
            placeholder="Tell us about your design project..."
            class="mt-3 w-full border-2 border-[#C5A46D] bg-transparent p-4"></textarea>

        <button type="submit"
            class="mt-4 w-full border-2 border-[#C5A46D] bg-[#C5A46D] p-4 font-black text-black transition hover:bg-transparent hover:text-[#C5A46D]">
            SEND INQUIRY
        </button>

        <p id="status" class="mt-3 text-sm font-bold"></p>

    </form>
</section>
