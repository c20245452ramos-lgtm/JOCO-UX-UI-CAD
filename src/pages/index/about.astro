    }

    .about-card-number {
        margin: 0 0 24px;
        color: var(--coral);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.16em;
    }

    .about-detail-card h3 {
        margin: 0 0 12px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 500;
        line-height: 1.15;
    }

    .about-detail-card > p:last-child {
        max-width: 480px;
        margin: 0;
        color: var(--muted);
        line-height: 1.75;
    }

    .about-detail-card-accent > p:last-child {
        color: rgba(243, 239, 231, 0.72);
    }

    .about-card-switch {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 24px;
        border: 1px solid var(--ink);
        padding: 12px 16px;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        cursor: pointer;
        transition: background 160ms ease, color 160ms ease;
    }

    .about-card-switch:hover,
    .about-card-switch[aria-pressed="true"] {
        background: var(--ink);
        color: var(--paper);
    }

    .about-card-switch:focus-visible {
        outline: 2px solid var(--coral);
        outline-offset: 3px;
    }

    .about-card-switch svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.7;
    }

    @media (max-width: 640px) {
        .about-card-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .about-detail-card,
        .about-card-switch {
            transition: none;
        }
    }
</style>
