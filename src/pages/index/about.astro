<section class="about-showcase" aria-labelledby="about-showcase-title">
    <div class="about-showcase-heading">
        <p>OUR DESIGN PRACTICE</p>
        <h2 id="about-showcase-title">Precision meets usability.</h2>
    </div>

    <div class="about-card-grid" id="about-card-grid">
        <article class="about-detail-card">
            <p class="about-card-number">01 — AUTOCAD</p>
            <h3>Technical Drafting</h3>
            <p>
                We create clear, detailed technical drawings and plans with careful attention to dimensions, structure, and accuracy.
            </p>
        </article>

        <article class="about-detail-card about-detail-card-accent">
            <p class="about-card-number">02 — UI/UX</p>
            <h3>Human-Centered Interfaces</h3>
            <p>
                We design intuitive layouts, user flows, and prototypes that make digital products easier and more enjoyable to use.
            </p>
        </article>
    </div>

    <button class="about-card-switch" type="button" aria-controls="about-card-grid" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 7h13l-3-3m3 3-3 3M17 17H4l3 3m-3-3 3-3" />
        </svg>
        Switch card positions
    </button>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        gsap.fromTo(
            "#about .about-art",
            { autoAlpha: 0, y: 24 },
            {
                autoAlpha: 1,
                y: 0,
                duration: 0.75,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#about .about-art",
                    start: "top 82%",
                    end: "bottom 18%",
                    toggleActions: "play reverse play reverse",
                },
            },
        );
    }

    const aboutCardGrid = document.querySelector<HTMLElement>("#about-card-grid");
    const aboutCardSwitch = document.querySelector<HTMLButtonElement>(".about-card-switch");

    aboutCardSwitch?.addEventListener("click", () => {
        if (!aboutCardGrid || !aboutCardSwitch || aboutCardGrid.children.length !== 2) return;

        aboutCardGrid.insertBefore(aboutCardGrid.children[1], aboutCardGrid.children[0]);
        const isSwapped = aboutCardSwitch.getAttribute("aria-pressed") !== "true";
        aboutCardSwitch.setAttribute("aria-pressed", String(isSwapped));
    });
</script>

<style>
