        gap: 20px;
    }

    .about-detail-card {
        min-height: 240px;
        border: 1px solid rgba(25, 26, 36, 0.16);
        padding: clamp(24px, 4vw, 40px);
        background: var(--paper);
        transition: border-color 180ms ease, transform 180ms ease;
    }

    .about-detail-card:hover {
