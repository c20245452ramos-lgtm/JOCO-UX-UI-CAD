
<!-- HOME / HERO -->
<section id="home" class="stripe p-6 md:p-16">

    <div class="mx-auto grid max-w-6xl items-center gap-8 md:grid-cols-2">

        <div class="card bg-[#111111] p-6 text-white md:p-8">

            <p class="text-sm font-black tracking-[0.3em] text-[#C5A46D]">
                AUTOCAD &amp; UI/UX DESIGNER
            </p>

            <h1 id="nameTitle"
                aria-label="Jory Myco."
                class="mt-5 text-5xl font-black uppercase leading-none md:text-7xl">
                <span class="scramble-word" data-scramble>Jory</span><br>
                <span class="scramble-word" data-scramble>Myco</span><span class="name-period">.</span>
            </h1>

            <p class="mt-5 font-medium leading-relaxed text-gray-400">
                Turning ideas into precise drawings and intuitive digital experiences.
            </p>

            <a href="#about"
                class="mt-6 inline-block border-2 border-[#C5A46D] px-6 py-3 font-black text-[#C5A46D] transition hover:bg-[#C5A46D] hover:text-black">
                DISCOVER OUR STORY
            </a>

        </div>

        <div class="card border border-[#C5A46D] bg-[#F5F5F5] p-8 md:p-10">
            <img
                class="hero-photo"
                src="/images/home-photo-1.png"
                alt="Portrait from the Jory Myco design team."
                width="512"
                height="512"
                fetchpriority="high"
            />
            <img
                class="home-photo-secondary"
                src="/images/home-photo-2.png"
                alt="A childhood birthday memory."
                width="420"
                height="315"
                loading="eager"
            />

            <p class="text-sm font-black tracking-[0.3em] text-[#9A783F]">
                DESIGN WITH PRECISION
            </p>

            <h2 class="mt-5 text-4xl font-black uppercase leading-tight text-black md:text-6xl">
                PLAN.<br>
                DESIGN.<br>
                DELIVER.
            </h2>

            <div class="mt-6 bg-[#111111] p-4 text-center font-black tracking-widest text-[#C5A46D]">
                WHERE IDEAS BECOME CLEAR DESIGNS.
            </div>

            <small class="photo-credit">AUTOCAD · UI/UX DESIGN</small>
        </div>

    </div>
</section>

<script>
    import { gsap } from "gsap";

    const scrambleCharacters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    const titleWords = Array.from(
        document.querySelectorAll<HTMLElement>("#nameTitle [data-scramble]"),
    );
    const finalTexts = titleWords.map((word) => word.textContent ?? "");
    const title = document.querySelector<HTMLElement>("#nameTitle");

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let completedWords = 0;

        if (title) {
            gsap.fromTo(
                title,
                { opacity: 0 },
                { opacity: 1, duration: 0.45, ease: "power2.out" },
            );
        }

        titleWords.forEach((word, wordIndex) => {
            const finalText = finalTexts[wordIndex];
            const progress = { value: 0 };

            gsap.to(progress, {
                value: finalText.length,
                delay: wordIndex * 0.18,
                duration: 0.9,
                ease: "none",
                onUpdate: () => {
                    const resolvedCharacters = Math.floor(progress.value);
                    word.textContent = Array.from(finalText)
                        .map((character, index) => {
                            if (index < resolvedCharacters) return character;
                            return scrambleCharacters[
                                Math.floor(Math.random() * scrambleCharacters.length)
                            ];
                        })
                        .join("");
                },
                onComplete: () => {
                    word.textContent = finalText;
                    completedWords += 1;

                    if (completedWords === titleWords.length && title) {
                        gsap.to(title, {
                            opacity: 0,
                            duration: 0.2,
                            ease: "power1.in",
                            onComplete: () => {
                                titleWords.forEach((titleWord, index) => {
                                    titleWord.textContent = finalTexts[index];
                                });
                                gsap.to(title, {
                                    opacity: 1,
                                    duration: 0.45,
                                    ease: "power2.out",
                                });
                            },
                        });
                    }
                },
            });
        });
    }
</script>

<style>
    #nameTitle .scramble-word {
        color: inherit;
    }

    #nameTitle .name-period {
        color: #c5a46d;
    }
</style>
