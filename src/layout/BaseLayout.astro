---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="theme-color" content="#191a24" />
        <meta
            name="description"
            content="JOCO Creative Arts — choreography, artistic direction, and dance production."
        />
        <title>JOCO — Creative Arts & Movement</title>
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style is:global>
    :root {
        color-scheme: light;
        --ink: #191a24;
        --paper: #f3efe7;
        --paper-deep: #e8e1d6;
        --coral: #ed6a4e;
        --gold: #c5a46d;
        --muted: #77736f;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
        scroll-padding-top: 90px;
        background: var(--paper);
    }

    body {
        min-width: 320px;
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    main > section {
        scroll-margin-top: 90px;
    }

    #home.stripe {
        position: relative;
        overflow: hidden;
        padding: clamp(48px, 8vw, 112px) 24px;
        background:
            radial-gradient(ellipse at 10% 12%, rgba(237, 106, 78, 0.12), transparent 32%),
            var(--paper);
    }

    #home > .mx-auto {
        display: grid;
        grid-template-columns: 1.08fr 0.92fr;
        max-width: 1180px;
        min-height: 500px;
        margin: 0 auto;
        align-items: stretch;
        gap: 0;
        filter: drop-shadow(0 26px 36px rgba(25, 26, 36, 0.13));
    }

    #home .card {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
        padding: clamp(32px, 6vw, 76px);
    }

    #home .card:first-child {
        z-index: 1;
        border-radius: 20px 0 0 20px;
        background: var(--ink);
        color: var(--paper);
    }

    #home .card:first-child::after {
        position: absolute;
        right: -112px;
        bottom: -180px;
        width: 330px;
        height: 330px;
        border: 1px solid rgba(237, 106, 78, 0.42);
        border-radius: 50%;
        box-shadow: 0 0 0 22px rgba(237, 106, 78, 0.04), 0 0 0 48px rgba(237, 106, 78, 0.04);
        content: "";
        pointer-events: none;
    }

    #home .card:first-child > * {
        position: relative;
        z-index: 1;
    }

    #home .card:first-child > p:first-child {
        margin: 0;
        color: var(--coral);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.22em;
        line-height: 1.6;
    }

    #home h1 {
        margin: 28px 0 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.6rem, 8vw, 7rem);
        font-weight: 500;
        letter-spacing: -0.075em;
        line-height: 0.88;
    }

    #home h1 span {
        color: var(--coral);
    }

    #home .card:first-child > p:last-of-type {
        max-width: 390px;
        margin: 28px 0 0;
        color: rgba(243, 239, 231, 0.72);
        font-size: 1rem;
        line-height: 1.8;
    }

    #home .card:first-child > a {
        width: fit-content;
        margin-top: 32px;
        border: 1px solid var(--coral);
        padding: 14px 20px;
        color: var(--paper);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-decoration: none;
        transition: background 160ms ease, color 160ms ease;
    }

    #home .card:first-child > a:hover {
        background: var(--coral);
        color: var(--ink);
    }

    #home .card:last-child {
        align-items: flex-start;
        border: 0;
        border-radius: 0 20px 20px 0;
        background: var(--ink);
        color: var(--paper);
    }

    #home .card:last-child::before {
        content: none;
    }

    #home .card:last-child > img.hero-photo {
        position: absolute;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        filter: brightness(0.72) saturate(1.05);
    }

    #home .card:last-child > * {
        position: relative;
        z-index: 1;
    }

    #home .card:last-child > p:first-child {
        margin: 0;
        color: var(--coral);
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.2em;
    }

    #home h2 {
        margin: 26px 0 0;
        color: var(--paper);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.2rem, 6.7vw, 6rem);
        font-weight: 500;
        letter-spacing: -0.075em;
        line-height: 0.9;
    }

    #home .card:last-child > div {
        margin-top: 30px;
        border-top: 1px solid rgba(243, 239, 231, 0.4);
        padding-top: 14px;
        color: var(--paper);
        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 0.18em;
    }

    #home .photo-credit {
        display: block;
        position: relative;
        z-index: 1;
        margin-top: 20px;
        color: rgba(243, 239, 231, 0.75);
        font-size: 0.58rem;
        line-height: 1.5;
        text-decoration-color: rgba(243, 239, 231, 0.4);
        text-underline-offset: 3px;
    }

    #home .photo-credit:hover {
        color: var(--paper);
    }

    #home .photo-credit a {
        color: inherit;
        text-decoration-color: rgba(243, 239, 231, 0.4);
        text-underline-offset: 3px;
    }

    #about {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: clamp(36px, 8vw, 120px);
        padding: clamp(64px, 10vw, 140px) max(24px, calc((100vw - 1120px) / 2));
        border: 0;
        background: var(--paper);
    }

    #about > div:first-child > p {
        margin: 0 0 18px;
        color: var(--coral);
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.2em;
    }

    #about h2 {
        margin: 0;
        padding: 0;
        color: var(--ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.8rem, 5vw, 5rem);
        font-weight: 500;
        letter-spacing: -0.06em;
        line-height: 0.98;
    }

    #about h2 span {
        color: var(--coral);
    }

    #about > div:last-child > p:first-child {
        margin: 0;
        color: var(--ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.25rem, 2.2vw, 1.8rem);
        line-height: 1.4;
    }

    #about > div:last-child > p:nth-child(2) {
        margin: 22px 0 0;
        color: var(--muted);
        line-height: 1.8;
    }

    #about > div:last-child > div {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 26px;
    }

    #about .about-art {
        position: relative;
        height: clamp(220px, 30vw, 340px);
        margin: 36px 0 0;
        overflow: hidden;
        background: var(--ink);
    }

    #about .about-art img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    #about .about-art figcaption {
        position: absolute;
        right: 12px;
        bottom: 12px;
        border: 1px solid rgba(243, 239, 231, 0.55);
        padding: 8px 10px;
        background: rgba(25, 26, 36, 0.78);
        color: var(--paper);
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.14em;
    }

    #about span {
        border: 1px solid rgba(25, 26, 36, 0.2);
        padding: 9px 12px;
        color: var(--ink);
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.08em;
    }

    #services.stripe {
        padding: clamp(64px, 9vw, 120px) max(24px, calc((100vw - 1120px) / 2));
        background: var(--ink);
        color: var(--paper);
    }

    #services > p:first-child {
        margin: 0 0 16px;
        color: var(--coral);
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.2em;
    }

    #services h2 {
        margin: 0 0 16px;
        border: 0;
        padding: 0;
        color: var(--paper);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3rem, 6vw, 5.5rem);
        font-weight: 500;
        letter-spacing: -0.06em;
    }

    #services .services-intro {
        max-width: 640px;
        margin: 0 0 42px;
        color: rgba(243, 239, 231, 0.72);
        font-size: 1rem;
        line-height: 1.75;
    }

    #services .programming-kicker {
        display: block;
        margin: 18px 0 10px;
        color: var(--coral);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.18em;
    }

    #services .programming-title {
        margin: 0 0 12px;
        color: var(--paper);
        font-size: 1rem;
        font-weight: 800;
        line-height: 1.4;
    }

    #services .skills-groups {
        display: grid;
        gap: 16px;
        margin-bottom: 20px;
    }

    #services .skills-group-label {
        display: block;
        margin-bottom: 8px;
        color: var(--coral);
        font-size: 0.58rem;
        font-weight: 900;
        letter-spacing: 0.14em;
    }

    #services .programming-skills {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    #services .programming-skills li {
        border: 1px solid rgba(243, 239, 231, 0.3);
        padding: 10px 13px;
        color: var(--paper);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
    }

    #services .services-feature {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
        align-items: center;
        margin: 0 0 48px;
        border: 1px solid rgba(243, 239, 231, 0.18);
        background: #232530;
    }

    #services .services-feature > img {
        display: block;
        width: 100%;
        height: auto;
    }

    #services .services-feature figcaption {
        padding: clamp(24px, 4vw, 48px);
    }

    #services .services-feature figcaption > span {
        color: var(--coral);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.16em;
    }

    #services .services-feature h3 {
        margin: 20px 0 12px;
        color: var(--paper);
        font-size: clamp(1.7rem, 3vw, 2.6rem);
    }

    #services .services-feature figcaption > p {
        margin: 0 0 24px;
        color: rgba(243, 239, 231, 0.72);
        line-height: 1.7;
    }

    #services .services-feature small {
        color: rgba(243, 239, 231, 0.6);
        font-size: 0.68rem;
        line-height: 1.7;
    }

    #services .services-feature small a {
        color: var(--paper);
        text-underline-offset: 3px;
    }

    #services > div:last-child {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    #services .card {
        min-height: 340px;
        border: 1px solid rgba(243, 239, 231, 0.16);
        padding: 0 0 26px;
        background: #232530;
        color: var(--paper);
    }

    #services .card > img {
        display: block;
        width: 100%;
        height: 150px;
        object-fit: cover;
    }

    #services .card > p,
    #services .card > h3 {
        margin-right: 26px;
        margin-left: 26px;
    }

    #services .card:nth-child(2) {
        background: var(--coral);
        color: var(--ink);
    }

    #services .card > p:nth-of-type(1) {
        margin-top: 20px;
        margin-bottom: 0;
        border: 0;
        padding: 0;
        color: var(--coral);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        font-weight: 500;
    }

    #services .card:nth-child(2) > p:nth-of-type(1) {
        color: var(--ink);
    }

    #services h3 {
        margin-top: 24px;
        margin-bottom: 12px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.25rem, 2vw, 1.7rem);
        font-weight: 500;
        line-height: 1.15;
    }

    #services .card > p:last-child {
        margin-top: 0;
        margin-bottom: 0;
        color: rgba(243, 239, 231, 0.68);
        font-size: 0.9rem;
        line-height: 1.7;
    }

    #services .card:nth-child(2) > p:last-child {
        color: rgba(25, 26, 36, 0.78);
    }

    #projects.projects-section {
        padding: clamp(64px, 9vw, 120px) max(24px, calc((100vw - 1120px) / 2));
        background: var(--paper);
        color: var(--ink);
    }

    #projects .projects-heading {
        max-width: 720px;
        margin-bottom: 42px;
    }

    #projects .projects-kicker {
        margin: 0 0 14px;
        color: var(--coral);
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.2em;
    }

    #projects .projects-heading h2 {
        margin: 0;
        color: var(--ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3rem, 6vw, 5.5rem);
        font-weight: 500;
        letter-spacing: -0.06em;
        line-height: 1;
    }

    #projects .projects-heading > p:last-child {
        max-width: 620px;
        margin: 18px 0 0;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.75;
    }

    #projects .project-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    #projects .project-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid rgba(25, 26, 36, 0.14);
        background: #fffdfa;
        transition: transform 180ms ease, box-shadow 180ms ease;
    }

    #projects .project-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 36px rgba(25, 26, 36, 0.12);
    }

    #projects .project-image {
        display: block;
        overflow: hidden;
        aspect-ratio: 4 / 3;
        background: var(--ink);
    }

    #projects .project-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 240ms ease;
    }

    #projects .project-card:hover .project-image img {
        transform: scale(1.04);
    }

    #projects .project-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
        padding: 24px;
    }

    #projects .project-category {
        margin: 0 0 12px;
        color: #a64b37;
        font-size: 0.62rem;
        font-weight: 900;
        letter-spacing: 0.13em;
    }

    #projects .project-content h3 {
        margin: 0 0 10px;
        color: var(--ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.55rem;
        font-weight: 500;
        line-height: 1.2;
    }

    #projects .project-content > p:not(.project-category) {
        margin: 0 0 22px;
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.7;
    }

    #projects .project-action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: auto;
        border-bottom: 1px solid var(--coral);
        padding-bottom: 5px;
        color: var(--ink);
        font-size: 0.75rem;
        font-weight: 900;
        text-decoration: none;
    }

    #projects .project-action span {
        color: var(--coral);
        transition: transform 160ms ease;
    }

    #projects .project-action:hover span {
        transform: translateX(4px);
    }

    #contact {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: clamp(36px, 8vw, 120px);
        padding: clamp(64px, 9vw, 120px) max(24px, calc((100vw - 1120px) / 2));
        border: 0;
        background: var(--paper-deep);
    }

    #contact > div:first-child > p:first-child {
        margin: 0;
        border: 0;
        padding: 0;
        color: var(--coral);
        font-size: 0.7rem;
        letter-spacing: 0.2em;
    }

    #contact h2 {
        margin: 22px 0 0;
        color: var(--ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.8rem, 7vw, 6.8rem);
        font-weight: 500;
        letter-spacing: -0.075em;
        line-height: 0.86;
    }

    #contact h2 span {
        color: var(--coral);
    }

    #contact > div:first-child > p:nth-of-type(2) {
        max-width: 420px;
        margin: 24px 0;
        color: var(--muted);
        line-height: 1.8;
    }

    #contact > div:first-child > div {
        color: var(--ink);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
    }

    #contact > div:first-child > div p {
        margin: 10px 0;
    }

    #contact form {
        display: flex;
        flex-direction: column;
        gap: 10px;
        border: 1px solid rgba(25, 26, 36, 0.12);
        padding: clamp(24px, 4vw, 42px);
        background: var(--paper);
        box-shadow: 0 16px 40px rgba(25, 26, 36, 0.06);
    }

    #contact form h3 {
        margin: 0 0 12px;
        color: var(--ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        font-weight: 500;
    }

    #contact form label {
        margin-top: 10px;
        color: var(--ink);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.12em;
    }

    #contact form input,
    #contact form select,
    #contact form textarea {
        width: 100%;
        border: 1px solid rgba(25, 26, 36, 0.22);
        border-radius: 0;
        padding: 14px;
        background: transparent;
        color: var(--ink);
        font: inherit;
    }

    #contact form input:focus,
    #contact form select:focus,
    #contact form textarea:focus {
        outline: 2px solid var(--coral);
        outline-offset: 2px;
    }

    #contact form button {
        margin-top: 12px;
        border: 1px solid var(--coral);
        padding: 15px;
        background: var(--coral);
        color: var(--ink);
        font: inherit;
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        cursor: pointer;
        transition: background 160ms ease, color 160ms ease;
    }

    #contact form button:hover {
        background: transparent;
        color: var(--ink);
    }

    #contact #status {
        min-height: 1.4em;
        margin: 0;
    }

    footer {
        gap: 18px;
        border-top: 0;
        padding: 28px max(24px, calc((100vw - 1120px) / 2));
        background: var(--ink);
        color: var(--paper);
        font-size: 0.75rem;
    }

    footer p {
        margin: 0;
    }

    footer p:first-child,
    footer a {
        color: var(--coral);
    }

    footer a {
        text-decoration: none;
    }

    footer a:hover {
        color: var(--paper);
    }

    footer p:last-child {
        color: rgba(243, 239, 231, 0.6);
    }

    @media (max-width: 960px) {
        #projects .project-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 760px) {
        #home > .mx-auto {
            grid-template-columns: 1fr;
        }

        #home .card:first-child {
            min-height: 400px;
            border-radius: 16px 16px 0 0;
        }

        #home .card:last-child {
            min-height: 350px;
            border-radius: 0 0 16px 16px;
        }

        #about,
        #contact {
            grid-template-columns: 1fr;
        }

        #services > div:last-child {
            grid-template-columns: 1fr;
        }

        #services .services-feature {
            grid-template-columns: 1fr;
        }

        #projects .project-grid {
            grid-template-columns: 1fr;
        }

        #services .card {
            min-height: 220px;
        }

        footer {
            justify-content: flex-start;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>
